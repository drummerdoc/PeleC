# Rung 4: a 3-D duct fed through a characteristic inflow carrying TurbInflow
# fluctuations.  4 x 1 x 1 cm, periodic across, 64 x 16 x 16 cells.
max_step  = 1000000
stop_time = 3.0e-3

geometry.is_periodic = 0 1 1
geometry.coord_sys   = 0
geometry.prob_lo     = 0.0 -0.5 -0.5
geometry.prob_hi     = 4.0  0.5  0.5
pelec.lo_bc = "UserBC" "Interior" "Interior"
pelec.hi_bc = "UserBC" "Interior" "Interior"

# The characteristic inflow at x = 0 (the case's duct mode); x = 4 cm keeps
# the case's hard-pressure fill.
pelec.bc_nscbc   = 1
prob.pulse_type  = 2
prob.u0          = 2000.0

# TurbInflow: the synthetic HIT box (2 pi periodic) mapped onto 1 cm --
# turb_scale_loc converts physical lengths to box lengths, so 2 pi here --
# u' = 100 cm/s (5 % of the mean), convected in at the mean velocity.  The
# case's bcnormal_nscbc adds turb_fluc to its inflow target.
turbinflows = xlo
turbinflow.xlo.turb_file      = ../HIT
turbinflow.xlo.dir            = 0
turbinflow.xlo.side           = low
turbinflow.xlo.turb_scale_loc = 6.283185
turbinflow.xlo.turb_scale_vel = 100.0
turbinflow.xlo.turb_center    = 0.0 0.0
turbinflow.xlo.turb_conv_vel  = 2000.0
turbinflow.xlo.turb_nplane    = 6
turbinflow.xlo.time_offset    = 0.0
turbinflow.xlo.tile_periodic  = 1

pelec.do_hydro = 1
pelec.do_mol   = 0
pelec.diffuse_vel  = 0
pelec.diffuse_temp = 0
pelec.diffuse_spec = 0
pelec.do_react = 0
pelec.cfl = 0.4
pelec.v = 1

amr.v = 0
amr.n_cell          = 64 16 16
amr.max_level       = 0
amr.blocking_factor = 8
amr.max_grid_size   = 16
amr.checkpoint_files_output = 0
amr.plot_int = 25
amr.plot_vars = density
amr.derive_plot_vars = x_velocity y_velocity z_velocity
